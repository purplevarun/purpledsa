# Copy this file to .env.local for local development.
# See README.md for full setup instructions.

# Postgres connection string.
# Local dev via Docker (docker compose up -d) uses trust auth, so no [REDACTED_SQL_PASSWORD_1]word is needed:
DATABASE_URL="postgresql://purpledsa@localhost:5432/purpledsa"
# For production, use a hosted Postgres connection string instead (e.g. Neon: https://neon.tech).

# Generate with: npx auth secret
AUTH_SECRET=""

# Local auth uses username/password and stores users in the same Postgres DB.
# Generate a secure secret with: npx auth secret
AUTH_SECRET=""
