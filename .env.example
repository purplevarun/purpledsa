# Copy this file to .env.local for local development.
# Do not commit .env.local.

# Required for both local and Vercel.
DATABASE_URL="postgresql://user:password@host:5432/database"
AUTH_SECRET="replace-with-a-random-secret"

# Optional: only needed if the frontend uses Supabase client-side directly.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# If you want a local Postgres fallback instead of Supabase,
# you can use Docker locally with:
# DATABASE_URL="postgresql://purpledsa@localhost:5432/purpledsa"
# and then run: docker compose up -d
