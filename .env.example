# Copy this file to .env.local for local development.
# See README.md for full setup instructions.

# Postgres connection string (Neon free tier recommended: https://neon.tech)
DATABASE_URL="postgresql://user:[REDACTED_SQL_PASSWORD_1]@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth App (create at https://github.com/settings/developers)
# Homepage URL: http://localhost:3000 (or your Vercel URL)
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
